<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>FieldCrypto.EntityFrameworkCore</PackageId>
    <Description>EF Core integration for FieldCrypto: encrypted string properties through value converters, blind index columns kept up to date by a SaveChanges interceptor, and blind index lookups with false-positive filtering.</Description>
    <PackageTags>encryption;efcore;entity-framework-core;blind-index;field-level-encryption</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldCrypto\FieldCrypto.csproj" />
  </ItemGroup>

</Project>
